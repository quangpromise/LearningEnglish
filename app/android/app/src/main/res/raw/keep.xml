<?xml version="1.0" encoding="utf-8"?>
<!--
  Cac resource ben duoi CHI duoc tham chieu qua CHUOI STRING dung o Dart
  (vd AndroidInitializationSettings('@drawable/ic_stat_notify'),
  RawResourceAndroidNotificationSound('notification_tone')) - khong co dong
  code/XML Android nao tham chieu truc tiep toi chung. Trinh rut gon resource
  cua Android (isShrinkResources = true trong build.gradle.kts, dung de giam
  dung luong APK) chi phan tich TINH (static analysis) cac tham chieu trong
  ma bien dich, nen se coi day la resource "khong dung" va XOA MAT khoi ban
  release - lam icon/am thanh thong bao that bai am tham (khong crash, chi
  don gian la KHONG hien/KHONG keu) ma khong co dau hieu loi ro rang.
  tools:keep buoc trinh rut gon giu lai du khong tim thay tham chieu tinh nao.
  Xem https://developer.android.com/build/shrink-code#keep-resources

  @drawable/audio_service_* - icon nut Phat/Tam dung/Bai truoc/Bai sau tren
  thong bao/man hinh khoa cho tinh nang nhac nen (package audio_service,
  dung boi just_audio_background) - CUNG duoc tham chieu qua chuoi string
  ("drawable/audio_service_skip_next"...) trong chinh source cua package do
  (MediaControl.skipToNext/skipToPrevious/play/pause...), nen cung bi rut
  gon xoa mat neu khong khai bao o day. Day rat co the la nguyen nhan THAT
  SU khien 1 so may (vd Huawei/EMUI) chi hien ten bai/nghe si + 1 chevron
  tren man hinh khoa ma khong co nut play/tam dung/bai truoc/sau - truoc day
  tung ket luan nham la "gioi han rendering cua OS", trong khi that ra la
  icon bi thieu tu phia app.
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_stat_notify,@raw/notification_tone,@drawable/audio_service_*" />

<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- App luon toi: ca che do sang va toi cua he dieu hanh deu dung theme toi,
         nen navy (spec #135 - truoc day Theme.Light gay nhay trang). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <!-- Man cho (Android <= 11), tu go khi Flutter ve khung dau tien. -->
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Nen cua so sau khi tien trinh chay, phia sau giao dien Flutter. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/splash_navy</item>
    </style>
</resources>

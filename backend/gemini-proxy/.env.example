# Copy file này thành .env và điền giá trị thật. KHÔNG commit file .env.
GEMINI_API_KEY=
PORT=8787

# Model Gemini Live - kiểm tra tên model preview mới nhất trước khi deploy:
# https://ai.google.dev/gemini-api/docs/live-api
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Địa chỉ nội bộ của fallback-pipeline (Python), dùng khi Gemini hết quota
FALLBACK_PIPELINE_URL=ws://localhost:8788

# Lấy từ Supabase Dashboard > Project Settings > API > JWT Secret (KHÔNG
# phải anon key hay service_role key) - dùng để xác thực client Flutter
# trước khi cho phép mở kết nối WebSocket voice-chat.
SUPABASE_JWT_SECRET=
